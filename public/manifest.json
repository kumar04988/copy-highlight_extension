{
  "manifest_version": 3,
  "name": "Clipboard Formattor",
  "version": "1.0.0",
  "description": "Search suggestions for highlighted text + a key/value clipboard store.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "index.html",
    "default_title": "Clipboard Formattor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
